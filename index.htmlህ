<!DOCTYPE html>
<html lang="am">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#071A2B">
<title>Ethiopia Premium Tools</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#071A2B;
  color:white;
}
header{
  padding:22px 18px;
  background:#0B2942;
  text-align:center;
}
header h1{
  margin:0;
  font-size:24px;
}
header p{
  margin:7px 0 0;
  color:#b9d7ea;
}
.container{
  padding:18px;
  max-width:650px;
  margin:auto;
}
.balance{
  background:linear-gradient(135deg,#123F5F,#0B2942);
  padding:20px;
  border-radius:18px;
  margin-bottom:20px;
}
.balance small{color:#b9d7ea}
.balance h2{
  margin:8px 0 0;
  font-size:30px;
}
.grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}
.card{
  background:#0D304A;
  border:1px solid #194967;
  border-radius:16px;
  padding:18px 12px;
  text-align:center;
  cursor:pointer;
  transition:.2s;
}
.card:active{transform:scale(.96)}
.icon{font-size:30px}
.card h3{
  margin:9px 0 5px;
  font-size:16px;
}
.card p{
  margin:0;
  color:#a9c5d7;
  font-size:12px;
}
.section{
  margin-top:25px;
}
.section h2{
  font-size:19px;
}
.referral{
  background:#123B55;
  padding:18px;
  border-radius:16px;
}
.referral button,
.premium button{
  width:100%;
  border:0;
  padding:13px;
  border-radius:12px;
  margin-top:12px;
  font-weight:bold;
  cursor:pointer;
}
.referral button{
  background:#19A974;
  color:white;
}
.premium{
  background:linear-gradient(135deg,#5A3E00,#8A6500);
  padding:18px;
  border-radius:16px;
}
.premium button{
  background:#FFD54A;
  color:#171000;
}
footer{
  text-align:center;
  padding:30px 10px;
  color:#7895a8;
  font-size:12px;
}
</style>
</head>

<body>

<header>
  <h1>🇪🇹 Ethiopia Premium Tools</h1>
  <p>AI • Money • Tools • Services</p>
</header>

<div class="container">

  <div class="balance">
    <small>Bonus Balance</small>
    <h2>100 ⭐</h2>
    <p>Welcome Bonus</p>
  </div>

  <div class="grid">

    <div class="card" onclick="openFeature('AI Assistant')">
      <div class="icon">🤖</div>
      <h3>AI Assistant</h3>
      <p>ጥያቄ ጠይቅ</p>
    </div>

    <div class="card" onclick="openFeature('AI Video Maker')">
      <div class="icon">🎬</div>
      <h3>AI Video</h3>
      <p>ቪዲዮ ፍጠር</p>
    </div>

    <div class="card" onclick="openFeature('House Designer')">
      <div class="icon">🏠</div>
      <h3>House Design</h3>
      <p>የቤት ዲዛይን</p>
    </div>

    <div class="card" onclick="openFeature('Send Money')">
      <div class="icon">💸</div>
      <h3>Send Money</h3>
      <p>ገንዘብ ላክ</p>
    </div>

    <div class="card" onclick="openFeature('Receive Money')">
      <div class="icon">💰</div>
      <h3>Receive Money</h3>
      <p>ገንዘብ ተቀበል</p>
    </div>

    <div class="card" onclick="openFeature('Request Money')">
      <div class="icon">📥</div>
      <h3>Request Money</h3>
      <p>ገንዘብ ጠይቅ</p>
    </div>

    <div class="card" onclick="openFeature('Currency')">
      <div class="icon">💱</div>
      <h3>Currency</h3>
      <p>ምንዛሬ</p>
    </div>

    <div class="card" onclick="openFeature('Calculator')">
      <div class="icon">🧮</div>
      <h3>Calculator</h3>
      <p>ማስሊያ</p>
    </div>

  </div>

  <div class="section">
    <h2>🎁 Referral</h2>
    <div class="referral">
      <p>ጓደኛህን ጋብዝና ሽልማት አግኝ!</p>
      <p>Your Referral Code: <b>EPT100</b></p>
      <button onclick="copyReferral()">📋 Copy Referral Link</button>
    </div>
  </div>

  <div class="section">
    <h2>⭐ Premium</h2>
    <div class="premium">
      <h3>Premium Membership</h3>
      <p>AI • Video • House Design • Premium Tools</p>
      <button onclick="openFeature('Premium')">Upgrade Now</button>
    </div>
  </div>

</div>

<footer>
  © 2026 Ethiopia Premium Tools
</footer>

<script>
function openFeature(name){
  alert(name + " — በቅርቡ ይከፈታል 🚀");
}

function copyReferral(){
  const link = window.location.origin + "?ref=EPT100";
  navigator.clipboard.writeText(link);
  alert("Referral Link ተቀድቷል ✅");
}
</script>

</body>
</html>
